# ---------- Planification ----------
# Intervalle entre deux articles (minutes). Par défaut : 6.
INTERVAL_MINUTES=6
# Générer un article dès le démarrage (true/false).
RUN_ON_START=true

# ---------- Serveur HTTP ----------
PORT=3000
HOST=0.0.0.0
# Jeton pour POST /api/run (déclenchement manuel). Sans jeton, seul localhost est autorisé.
ADMIN_TOKEN=

# ---------- Contenu ----------
# Langues produites pour chaque article et proposées dans l'interface (fr, en, ar). Avec Claude, les
# versions sont rédigées en un seul appel ; en mode extractif, seuls les intitulés sont traduits.
LANGUAGES=fr,en,ar
# Langue principale (interface par défaut, champs de premier niveau de l'API). Vide = première de LANGUAGES.
ARTICLE_LANGUAGE=
# Sujets (ordre de rotation). Vide = tous. Identifiants : pharmaceutique, peptides, nouveaux-medicaments,
# biosimilaires, biologiques, essais-cliniques, therapie-genique-arn, antimicrobiens
TOPICS=
# Nombre maximal d'articles conservés dans le carrousel.
MAX_ARTICLES=500
# Répertoire des données (articles.json, seen.json, state.json, images/).
DATA_DIR=data

# ---------- PubMed / NCBI E-utilities ----------
# Point d'accès E-utilities (à changer uniquement pour un miroir ou le faux serveur de test).
PUBMED_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
PUBMED_TIMEOUT_MS=20000
# Clé API NCBI (optionnelle, 10 requêtes/s au lieu de 3) : https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=
# Adresse e-mail de contact (recommandée par NCBI).
NCBI_EMAIL=daaklaas.legacy@gmail.com
NCBI_TOOL=carrousel-sci-bot
# Identifiants par page esearch (jusqu'à 5 pages par fenêtre) et fenêtres de dates disjointes, de
# plus en plus anciennes (jours) : 14,60,365 → [J-14, J], puis [J-60, J-14], puis [J-365, J-60].
PUBMED_RETMAX=40
PUBMED_WINDOWS_DAYS=14,60,365
# Score de pertinence minimal pour retenir une notice.
MIN_RELEVANCE=4

# ---------- Rédaction (Claude, SDK Anthropic) ----------
# Identifiants résolus par le SDK : ANTHROPIC_API_KEY, ou ANTHROPIC_AUTH_TOKEN, ou un profil `ant auth login`.
# Sans identifiants, le bot utilise un générateur extractif (sections et points clés tirés du résumé).
ANTHROPIC_API_KEY=
CLAUDE_ENABLED=true
CLAUDE_MODEL=claude-opus-5-5
# Effort de raisonnement : low | medium | high | xhigh | max
CLAUDE_EFFORT=medium
# Jetons de sortie maximaux (raisonnement adaptatif compris).
CLAUDE_MAX_TOKENS=16000
# Repli serveur sur refus de politique : default | off
CLAUDE_FALLBACKS=default
# Réponse diffusée en continu : CLAUDE_TIMEOUT_MS borne l'attente du premier octet (par tentative),
# CLAUDE_HARD_TIMEOUT_MS borne la requête entière ; le total doit rester < INTERVAL_MINUTES.
CLAUDE_TIMEOUT_MS=120000
CLAUDE_MAX_RETRIES=1
CLAUDE_HARD_TIMEOUT_MS=300000

# ---------- Illustrations ----------
# svg (illustrations scientifiques procédurales, sans clé) | openai (gpt-image-1, repli SVG en cas d'erreur)
IMAGE_PROVIDER=svg
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_BASE_URL=https://api.openai.com/v1
IMAGE_TIMEOUT_MS=120000

LOG_LEVEL=info
